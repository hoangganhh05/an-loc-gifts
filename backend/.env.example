PORT=3001
HOST=127.0.0.1
# Set both values before first startup to provision a real administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true only behind HTTPS in production.
COOKIE_SECURE=false
# Keep false until business and age-verification procedures are reviewed.
COMMERCE_ENABLED=false

# Local default is SQLite; set mysql to use your MySQL server.
DB_CLIENT=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=an_loc_gifts
# false for a cloud database that has already been created.
MYSQL_CREATE_DATABASE=true
# Enable TLS for online MySQL when supported/required by the provider.
MYSQL_SSL=false
# Optional PEM CA certificate; literal \n is accepted between lines.
MYSQL_SSL_CA=
